{
  "rules": {
    ".read": false,
    ".write": false,
    "pameldinger": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['navn', 'rett'])",
        "navn": {
          ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().replace(' ', '').length > 0"
        },
        "rett": {
          ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().replace(' ', '').length > 0"
        },
        "$annet": {
          ".validate": false
        }
      }
    }
  }
}
