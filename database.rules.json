{
  "rules": {
    ".read": false,
    ".write": false,
    "pameldinger": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['navn', 'rett', 'kategori'])",
        "navn": {
          ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().replace(' ', '').length > 0"
        },
        "rett": {
          ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().replace(' ', '').length > 0"
        },
        "kategori": {
          ".validate": "newData.isString() && newData.val().matches(/^(kjott|fisk|vegetar|brod|dessert)$/)"
        },
        "allergener": {
          "$allergen": {
            ".validate": "$allergen.matches(/^(gluten|laktose|notter|skalldyr)$/) && newData.isBoolean() && newData.val() === true"
          }
        },
        "$annet": {
          ".validate": false
        }
      }
    }
  }
}
